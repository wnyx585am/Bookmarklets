//URL parameter-based drive box selection
javascript:(function(){var p=new URLSearchParams(window.location.search);var l=p.get('limit');var minLat=44.1500,maxLat=45.5500,minLng=-94.2000,maxLng=-92.7500;if(l==="1"){minLat=44.4500;maxLat=45.2500;minLng=-93.7500;maxLng=-92.8500;}else if(l==="2"){minLat=43.5000;maxLat=46.4408;minLng=-95.5383;maxLng=-92.7500;}var lat=(Math.random()*(maxLat-minLat)+minLat).toFixed(6);var lng=(Math.random()*(maxLng-minLng)+minLng).toFixed(6);window.open('https://google.com/maps/place/'+lat+','+lng);})();

//Prompt-based drive box selection
javascript:(function(){var choice=prompt("Enter driving limit in hours (1, 1.5, or 2):","1.5");var minLat=44.1500,maxLat=45.5500,minLng=-94.2000,maxLng=-92.7500;if(choice==="1"){minLat=44.4500;maxLat=45.2500;minLng=-93.7500;maxLng=-92.8500;}else if(choice==="2"){minLat=43.5000;maxLat=46.4408;minLng=-95.5383;maxLng=-92.7500;}if(choice!==null){var lat=(Math.random()*(maxLat-minLat)+minLat).toFixed(6);var lng=(Math.random()*(maxLng-minLng)+minLng).toFixed(6);window.open('https://google.com/maps/place/'+lat+','+lng);}})();

